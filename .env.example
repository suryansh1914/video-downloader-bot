# ─── Required ────────────────────────────────────────────────────────────────
BOT_TOKEN=your-telegram-bot-token-here

# ─── Limits ──────────────────────────────────────────────────────────────────
MAX_DURATION_SECONDS=600          # Max video duration (10 min)
MAX_FILE_SIZE_MB=200              # Max download size
TELEGRAM_UPLOAD_LIMIT_MB=50       # Telegram bot API limit
MAX_CONCURRENT_JOBS=3             # Parallel downloads
RATE_LIMIT_PER_HOUR=10            # Per-user rate limit
JOB_TIMEOUT_SECONDS=300           # Timeout per download (5 min)

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
